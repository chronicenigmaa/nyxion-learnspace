# ─────────────────────────────────────────────────────────────────────────
# Nyxion LearnSpace — backend environment
# Copy to .env for local dev; set the same keys as Railway variables in prod.
# ─────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────

# Supabase Postgres. Project Settings → Database → Connection string → URI.
# Prefer the Session Pooler URI (port 5432) for a long-running server.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Postgres schema holding this product's tables. LearnSpace and EduOS share one
# Supabase project and both define `users`/`events`, so each product gets its
# own schema. Set this to "eduos" on the EduOS backend. Do NOT use "public".
DB_SCHEMA=learnspace

# Signs every JWT. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Changing this invalidates all sessions and all outstanding password-reset links.
SECRET_KEY=change-me-to-a-long-random-string

# Public URL of the FRONTEND. Used to build password-reset links in emails.
APP_BASE_URL=https://learnspace.yourdomain.com


# ── EMAIL (password resets, admin invites) ───────────────────────────────
# Without RESEND_API_KEY the app still runs, but no email is ever sent and
# password reset cannot complete on its own.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# The domain must be verified in Resend. Until then use onboarding@resend.dev,
# which only delivers to the address that owns the Resend account.
MAIL_FROM=Nyxion LearnSpace <noreply@yourdomain.com>


# ── AI FEATURES ──────────────────────────────────────────────────────────
# Without this, every /api/v1/ai/* route returns 503 and the AI pages show
# "AI service not configured". Free key from console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx


# ── FIRST-RUN SETUP ──────────────────────────────────────────────────────
# Enables POST /api/v1/admin/bootstrap and the /setup page, which create the
# FIRST super admin. The route refuses once a super admin exists.
# REMOVE THIS VARIABLE once you have signed in successfully.
BOOTSTRAP_SECRET=


# ── OPTIONAL ─────────────────────────────────────────────────────────────

# Structured logging to a Supabase `app_logs` table. Omit to disable.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=
SERVICE_NAME=learnspace

# EduOS bridge. Omit if LearnSpace runs standalone.
# Used for two things: reading a child's fees, and syncing the parent → student
# links that EduOS owns into parent_children.
# EDUOS_SERVICE_TOKEN must be an EduOS JWT for a super_admin or school_admin.
# The parent-link sync only runs when BOTH of these are set.
EDUOS_API_URL=
EDUOS_SERVICE_TOKEN=

# How often to pull parent → student links from EduOS. Default 30.
# EduOS is authoritative: each run replaces the links of every parent EduOS
# reports, so a link made in LearnSpace's own parents page for such a parent is
# removed on the next run. GET /health/eduos-sync shows the last outcome.
EDUOS_SYNC_INTERVAL_MINUTES=30

# Where uploaded files land. Defaults to /uploads (the Docker volume).
UPLOAD_DIR=/uploads


# ── DANGEROUS — LEAVE UNSET IN PRODUCTION ────────────────────────────────

# Returns the password-reset token in the HTTP response when no mail provider
# is configured. Turns /forgot-password into a one-request account takeover.
# Local development only.
ALLOW_RESET_TOKEN_IN_RESPONSE=

# Allows a super admin to call /api/v1/seed/seed-demo, which creates accounts
# with the published password "demo123". Never enable on a real school's data.
ALLOW_DEMO_SEED=
